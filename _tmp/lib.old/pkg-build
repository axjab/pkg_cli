#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

main() {
    if (( $# != 1 )) || [[ ! $1 =~ ^[a-z0-9][a-z0-9+.-]+$ ]]; then
        printf 'Usage: pkg build <package-name>\n' >&2
        exit 2
    fi
    local pkg="$1"
    local source="$ROOT/deb/$pkg"
    local control="$source/DEBIAN/control"

    [[ -f "$control" ]] || {
        echo "Error: Package '$pkg' does not exist." >&2
        exit 1
    }

    # Build using the package's control metadata.
    mkdir -p "$ROOT/dist"
    dpkg-deb --root-owner-group --build "$source" "$ROOT/dist/"

    # Resolve the generated archive filename.
    local name version arch artifact
    name=$(sed -n 's/^Package: *//p' "$control")
    version=$(sed -n 's/^Version: *//p' "$control")
    arch=$(sed -n 's/^Architecture: *//p' "$control")
    artifact="$ROOT/dist/${name}_${version}_${arch}.deb"

    # Verify the archive and its contents.
    echo
    echo "Verifying $artifact..."

    dpkg-deb --info "$artifact"
    dpkg-deb --contents "$artifact"
    dpkg-deb --fsys-tarfile "$artifact" | tar -tf - >/dev/null

    echo
    echo "Build verified: $artifact"
}

main "$@"
