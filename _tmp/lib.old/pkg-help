#!/usr/bin/env bash
set -euo pipefail

main() {
    if (( $# > 1 )); then
        printf 'Usage: pkg help [command]\n' >&2
        exit 2
    fi
    case "${1:-all}" in
        all) overview; init_help; add_help; build_help; push_help ;;
        init) init_help ;;
        add) add_help ;;
        build) build_help ;;
        push) push_help ;;
        help) printf 'Usage: pkg help [command]\nTopics: init, add, build, push, help\n' ;;
        *) printf 'No detailed help for: %s\n' "$1" >&2; exit 2 ;;
    esac
}

overview() {
    cat <<'HELP'
Usage
  pkg <command> [arguments...]
  pkg help [command]
  pkg --help

Commands
  init     Create a Debian package skeleton.
  add      Stage an executable in an existing package.
  build    Build and inspect a Debian archive.
  push     Reserved for publication; currently unfinished.
  help     Show this guide or one command's help.

Layout
  pkg                         Public command
  libexec/pkg-*               Executable subcommands
  packages/<name>/DEBIAN/     Debian control metadata
  packages/<name>/bin/        Executables installed by the package
  dist/                       Built archives
  scripts/                    Supporting scripts
  docs/                       Documentation

Paths
  packages/ and dist/ are resolved relative to this checkout.
  An executable passed to add is resolved from your current directory.
  The dispatcher preserves arguments, standard input/output and exit status.
  Add an executable libexec/pkg-NAME to expose it as pkg NAME.
  A symlink to the root pkg command can be placed on PATH.
  Debian prerequisites include Bash, coreutils, dpkg-deb, sed and tar.

Example
  ./pkg init core
  # Edit packages/core/DEBIAN/control.
  ./pkg add /path/to/tty-notify core
  ./pkg build core

Installation
  Configure the ALJ APT source once on each target machine.
  Then run sudo apt update and sudo apt install core.
  The APT repository supplies the archive to the target machine.

HELP
}

init_help() {
    cat <<'HELP'
pkg init [package-name]
  Prompts for a name when omitted. Creates bin/ and DEBIAN/control under
  packages/. Names use lowercase letters, digits, +, - and . and must
  start with a letter or digit and contain at least two characters.
  Existing package directories are rejected.
  The initial version is 0.0.0 and architecture is all.
  Edit the TODO maintainer and description before building.
  Git initialization and per-package instructions are future work.

HELP
}

add_help() {
    cat <<'HELP'
pkg add <executable> [package-name]
  Copies a readable executable into the package's bin/ with mode 0755.
  A relative executable path is relative to your current directory.
  Omitting the package selects the sole existing package, or prompts
  interactively when several exist. Noninteractive ambiguity fails.
  Identical files are skipped. Replacing a different file requires
  interactive confirmation. Symlink destinations are rejected.
  External APT dependencies currently go in DEBIAN/control's Depends
  field, for example Depends: network-manager. This command currently
  accepts executable files only.

HELP
}

build_help() {
    cat <<'HELP'
pkg build <package-name>
  Builds packages/<name>/ with dpkg-deb --root-owner-group.
  Writes dist/<Package>_<Version>_<Architecture>.deb using control metadata.
  Prints the archive information and file list, then checks tar extraction.
  A higher Version is needed when publishing changed package contents.
  Building does not install the package on the host.

HELP
}

push_help() {
    cat <<'HELP'
pkg push <package-name>
  The supplied implementation is unfinished. This command exits nonzero.
  The intended workflow uploads the selected archive, regenerates Packages
  and Packages.gz, generates Release, then signs and verifies InRelease.
  The existing publication target is SSH alias publish and public/apt
  on the remote server. Complete publication before using this command.

HELP
}

main "$@"
