#!/usr/bin/env bash
set -euo pipefail
lib=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$lib/package.sh"
source "$lib/hosts.sh"
source "$lib/progress.sh"
# Keep redirected diagnostics plain, including the shared debug helper.
[[ -t 2 ]] || export NO_COLOR=1
source "$lib/push-output.sh"
usage='Usage: pkg push [-f] [<package>] [to <host>]'
if [[ $# == 1 && $1 == help ]]; then
    printf '%s\n' "$usage"
    cat <<'HELP'

Publish a built archive from workspace dist/ to a signed trixie APT
repository for amd64, including architecture-independent packages.
Build first with pkg build <package>. If several versions exist in dist/,
selection prompts in a terminal; scripts must leave one matching archive.
Use -f to replace a published archive with the same package, version, and architecture.
Omitted package/host choices use the sole choice or prompt in a terminal.
The target account's home is the repository root. Literal localhost runs locally.
A new unsigned repository without a secret key gets a dedicated signing key
without a passphrase. Existing signing keys must be usable without a prompt.
HELP
    exit 0
fi
pkg_debug command push
force=0
if [[ ${1:-} == -f ]]; then
    force=1
    shift
fi
package_args=()
host=''
if (( $# == 1 || $# == 3 )); then
    package_args=("$1")
    shift
fi
case $# in
    0) ;;
    2) [[ $1 == to && -n $2 ]] || pkg_fail "$usage" 2; host=$2 ;;
    *) pkg_fail "$usage" 2 ;;
esac
root=$(pkg_require_workspace)
package=$(pkg_select_package "$root" 'pkg push <package> [to <host>]' "${package_args[@]}")
name=${package##*/}
command -v dpkg-deb >/dev/null || pkg_fail 'dpkg-deb is required to check built packages'
archives=()
for archive in "${root%/}/dist/${name}_"*.deb; do
    [[ -e $archive || -L $archive ]] || continue
    [[ -f $archive && ! -L $archive ]] || pkg_fail "invalid archive: $archive"
    archive_name=$(dpkg-deb --field "$archive" Package) || pkg_fail "invalid archive: $archive"
    [[ $archive_name == "$name" ]] || pkg_fail "archive metadata does not match $name: $archive"
    archives+=("$archive")
done
case ${#archives[@]} in
    0) pkg_fail "no built archive for $name in dist/. Run pkg build $name first." ;;
    1) archive=${archives[0]} ;;
    *)
        [[ -t 0 ]] || pkg_fail "multiple built archives for $name; keep one version in dist/ or select interactively."
        archive_names=()
        for candidate in "${archives[@]}"; do
            archive_names+=("${candidate##*/}")
        done
        choice=$(pkg_choose 'Available archives:' 'Archive filename' "${archive_names[@]}")
        archive=''
        for candidate in "${archives[@]}"; do
            [[ ${candidate##*/} != "$choice" ]] || archive=$candidate
        done
        [[ -n $archive ]] || pkg_fail 'select a listed archive'
        ;;
esac
architecture=$(dpkg-deb --field "$archive" Architecture)
[[ $architecture == all || $architecture == amd64 ]] || pkg_fail "unsupported archive architecture: $architecture (expected all or amd64)"
dpkg-deb --fsys-tarfile "$archive" | tar -tf - >/dev/null
pkg_debug push.artifact "$archive"
if [[ -n $host ]]; then
    pkg_debug host.selection explicit
else
    host=$(pkg_select_host 'pkg push [<package>] to <host>')
fi
pkg_valid_host "$host" || pkg_fail 'expected an SSH alias or user@hostname' 2
pkg_debug host.target "$host"
command -v sha256sum >/dev/null || pkg_fail 'sha256sum is required to transfer packages'
digest_line=$(sha256sum < "$archive")
checksum=${digest_line%% *}
[[ $checksum =~ ^[0-9a-f]{64}$ ]] || pkg_fail 'could not compute archive SHA-256'
pkg_debug push.archive_sha256 "$checksum"

debug=0
color_setting=
[[ ${PKG_DEBUG:-0} == 1 ]] && debug=1
[[ -n ${NO_COLOR:-} ]] && color_setting=1
# Pass the script as an argument so stdin carries only the archive bytes.
remote_script=$(
    printf 'export PKG_DEBUG=%s NO_COLOR=%s\n' "$debug" "$color_setting"
    cat -- "$lib/workspace.sh" "$lib/push-output.sh" "$lib/push-metadata.sh" "$lib/push-publish.sh" "$lib/push-readiness.sh"
)
if [[ $host == localhost ]]; then
    pkg_debug host.transport local
    transport=(bash -c "$remote_script" pkg-push "$checksum" "$force")
else
    pkg_debug host.transport ssh
    # SSH runs a shell command; escape each single quote inside the script.
    printf -v remote_command "bash -c '%s' pkg-push '%s' '%s'" "${remote_script//\'/\'\\\'\'}" "$checksum" "$force"
    transport=(ssh -T -o BatchMode=yes -o ConnectTimeout=5 -o ConnectionAttempts=1 -o ClearAllForwardings=yes -- "$host" "$remote_command")
fi
if received_checksum=$(pkg_run_with_spinner "Publishing ${archive##*/} to $host" "${transport[@]}" < "$archive"); then
    [[ $received_checksum == "$checksum" ]] || pkg_fail "no matching publication acknowledgement from $host"
    pkg_push_result 32 "Published ${archive##*/} to $host (trixie/amd64)"
else
    status=$?
    pkg_debug push.result failed
    pkg_debug push.exit "$status"
    pkg_push_result 31 "pkg: push failed for $host (exit $status)"
    exit "$status"
fi
