#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/hosts.sh"

if [[ $# == 1 && $1 == help ]]; then
    cat <<'HELP'
Usage: pkg host
       pkg hosts
       pkg host add <host>

List publication destinations or remember an SSH alias or user@hostname.
Hosts are stored in the nearest workspace. Registration works offline.
Package creation, file staging, and builds use the local workspace.

Example: pkg host add pkg-host
Example: pkg host add apt@old_shrine
HELP
    exit 0
fi

pkg_debug command host
case $# in
    0) action=list ;;
    2)
        if [[ $1 != add ]] || ! pkg_valid_host "$2"; then
            printf 'Usage: pkg host add <host>\n' >&2
            exit 2
        fi
        action=add
        host=$2
        ;;
    *) printf 'Usage: pkg host [add <host>]\n' >&2; exit 2 ;;
esac
pkg_load_hosts

if [[ $action == list ]]; then
    if (( ${#hosts[@]} )); then
        printf '%s\n' "${hosts[@]}"
    else
        printf 'No hosts configured. Add one with pkg host add <host>.\n' >&2
    fi
    exit 0
fi

pkg_debug host.target "$host"
mkdir -p -- "$hosts_directory"
# Each empty directory is one registration. mkdir rejects concurrent duplicates.
if mkdir -- "$hosts_directory/$host"; then
    pkg_debug host.result added
    printf 'Added host %s\n' "$host"
else
    status=$?
    pkg_debug host.result failed
    exit "$status"
fi
