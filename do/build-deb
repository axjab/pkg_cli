#!/usr/bin/env bash
set -euo pipefail

if (( $# > 1 )) || [[ $# == 1 && $1 != -f ]]; then
    printf 'Usage: do/build-deb [-f]\n' >&2
    exit 2
fi

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
cd -- "$root"
staging=$(mktemp -d)
trap 'rm -rf -- "$staging"' EXIT

export SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-0}
PKG_COMPILE_DIR="$staging" "$root/do/compile" >/dev/null
"$staging/pkg" add -f executable "$staging/pkg" to pkg-cli >&2
"$staging/pkg" build "$@" pkg-cli
