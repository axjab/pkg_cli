#!/usr/bin/env bash
set -euo pipefail

usage='Usage: publish-check-ssh <ssh-target>'
if [[ $# == 1 && $1 == help ]]; then
    printf '%s\n' "$usage"
    exit 0
fi
if (( $# != 1 )); then
    printf '%s\n' "$usage" >&2
    exit 2
fi

target=$1
if [[ ! $target =~ ^([a-zA-Z0-9_][a-zA-Z0-9_.-]*@)?[a-zA-Z0-9_:][a-zA-Z0-9_.:%-]*$ ]]; then
    printf 'publish-check-ssh: expected an SSH alias, host, or user@host\n' >&2
    exit 2
fi

if ssh -nT -o BatchMode=yes -o ConnectTimeout=5 -o ConnectionAttempts=1 \
    -o ClearAllForwardings=yes -- "$target" true; then
    printf 'SSH check passed for %s\n' "$target"
else
    status=$?
    printf 'publish-check-ssh: SSH check failed for %s (exit %s)\n' "$target" "$status" >&2
    exit "$status"
fi
